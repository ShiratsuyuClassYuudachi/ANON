MONGO_URI=mongodb://localhost:27017/anon
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
UPLOAD_DIR=uploads
CRON_SECRET=
SUPER_ADMIN_EMAIL=
# 试用模式账号邮箱：该邮箱 + 任意 ≥8 位密码登录进入独立演示环境，置空禁用
TRIAL_EMAIL=admin@test.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push（VAPID）推送通知（可选）：npx web-push generate-vapid-keys 生成公/私钥
# 未配置时推送渠道静默禁用（邮件提醒不受影响）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 平台账号服务端加密密钥（可选，缺省回退 JWT_SECRET）
PLATFORM_CRYPTO_KEY=

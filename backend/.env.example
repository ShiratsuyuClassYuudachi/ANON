MONGO_URI=mongodb://localhost:27017/anon
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
UPLOAD_DIR=uploads
CRON_SECRET=
SUPER_ADMIN_EMAIL=
# 试用模式账号邮箱：该邮箱 + 任意 ≥8 位密码登录进入独立演示环境，置空禁用
TRIAL_EMAIL=admin@test.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push（VAPID）推送通知（可选）：npx web-push generate-vapid-keys 生成公/私钥
# 未配置时推送渠道静默禁用（邮件提醒不受影响）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# QQ 机器人通知（可选）：QQ 开放平台 Bot API v2 凭证（q.qq.com 机器人管理端获取）
# 未配置时 QQ 渠道静默禁用（邮件/推送提醒不受影响）；sandbox=true 走沙箱环境
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_BOT_SANDBOX=
# AI 待办解析（可选）：OpenAI 兼容接口凭证，默认 DeepSeek；QQ 群里 @机器人 发任务描述自动创建待办
# 未配置 AI_API_KEY 时该功能静默禁用（QQ 绑定/通知不受影响）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# 前端公开地址（可选）：QQ 通知消息末尾附「查看」链接时用作基座，如 https://app.example.com
PUBLIC_BASE_URL=

# 平台账号服务端加密密钥（可选，缺省回退 JWT_SECRET）
PLATFORM_CRYPTO_KEY=
